# Perfil remoto PostgreSQL/Supabase. Copie para um arquivo .env ignorado pelo
# Git ou configure estas variáveis diretamente na IDE/runtime.
SPEEDDESK_DB_URL=jdbc:postgresql://db.example.invalid:5432/postgres?sslmode=require
SPEEDDESK_DB_USERNAME=speeddesk_app
SPEEDDESK_DB_PASSWORD=replace-with-a-secret
SPEEDDESK_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
SPEEDDESK_JWT_EXPIRATION_SECONDS=3600
SPEEDDESK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
SPEEDDESK_PASSWORD_RESET_EXPIRATION_MINUTES=30
SPEEDDESK_OPENAPI_ENABLED=false
